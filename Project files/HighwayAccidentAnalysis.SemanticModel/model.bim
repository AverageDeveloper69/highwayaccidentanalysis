          },
          {
            "name": "NH Accidents 2022",
            "expression": "CALCULATE([NH Accidents], REMOVEFILTERS('FactAnnualSummary'[year]), 'FactAnnualSummary'[year] = 2022)",
            "formatString": "#,0",
            "lineageTag": "b6b1e704-1c0d-4aa5-9496-ec8ef63e0a23"
          },
          {
            "name": "NH Fatalities 2022",
            "expression": "CALCULATE([NH Fatalities], REMOVEFILTERS('FactAnnualSummary'[year]), 'FactAnnualSummary'[year] = 2022)",
            "formatString": "#,0",
            "lineageTag": "2a334eb7-ddfc-449c-b3b4-18def4b53952"
          },
          {
            "name": "NH Accident Share 2022",
            "expression": "DIVIDE([NH Accidents 2022], CALCULATE([All Road Accidents], REMOVEFILTERS('FactAnnualSummary'[year]), 'FactAnnualSummary'[year] = 2022))",
            "formatString": "0.0%",
            "lineageTag": "18adb39a-dbc4-4311-ad1e-8579496d0211"
          },
          {
            "name": "NH Fatality Share 2022",
            "expression": "DIVIDE([NH Fatalities 2022], CALCULATE([All Road Fatalities], REMOVEFILTERS('FactAnnualSummary'[year]), 'FactAnnualSummary'[year] = 2022))",
            "formatString": "0.0%",
            "lineageTag": "681f2a5a-862c-4ecd-809b-b3d7d55a9592"
          },
          {
            "name": "All Road Accidents 2022",
            "expression": "CALCULATE([All Road Accidents], REMOVEFILTERS('FactAnnualSummary'[year]), 'FactAnnualSummary'[year] = 2022)",
            "formatString": "#,0",
            "lineageTag": "2f150bd1-4b0b-428f-a8ac-772ba6ee135d"
          },
          {
            "name": "All Road Fatalities 2022",
            "expression": "CALCULATE([All Road Fatalities], REMOVEFILTERS('FactAnnualSummary'[year]), 'FactAnnualSummary'[year] = 2022)",
            "formatString": "#,0",
            "lineageTag": "511cf797-fbda-4d33-bed4-3128ec04bcbe"
          },
          {
            "name": "All Road Injuries 2022",
            "expression": "CALCULATE([All Road Injuries], REMOVEFILTERS('FactAnnualSummary'[year]), 'FactAnnualSummary'[year] = 2022)",
            "formatString": "#,0",
            "lineageTag": "8a7051a6-c227-42f5-bdf5-9381e25f1955"
          },
          {
            "name": "NH Accidents YoY 2022",
            "expression": "VAR CurrentYear = CALCULATE([NH Accidents], REMOVEFILTERS('FactAnnualSummary'[year]), 'FactAnnualSummary'[year] = 2022) VAR PriorYear = CALCULATE([NH Accidents], REMOVEFILTERS('FactAnnualSummary'[year]), 'FactAnnualSummary'[year] = 2021) RETURN DIVIDE(CurrentYear - PriorYear, PriorYear)",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "31347fe2-2b76-4c29-a4ea-8990a7558363"
          },
          {
            "name": "NH Fatalities per 100 Accidents 2022",
            "expression": "DIVIDE([NH Fatalities 2022], [NH Accidents 2022]) * 100",
            "formatString": "0.0",
            "lineageTag": "ce08b9f3-efcf-4e90-af68-764f76c2a77e"
          }
        ],
